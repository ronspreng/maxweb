# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# ClickHub Tracker
CLICKHUB_API_KEY=
CLICKHUB_BASE_URL=https://tracker.clickhub.co/api

# MaxWeb Dashboard (optional - for scraping)
MAXWEB_USERNAME=
MAXWEB_PASSWORD=

# Apify Web Scraping
USE_APIFY=false
APIFY_API_TOKEN=

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Streamlit local-dev auth (alleen actief als STREAMLIT_AUTH_ENABLED=true)
STREAMLIT_AUTH_ENABLED=true
STREAMLIT_PASSWORD=change_me_locally

# ClickHub click-out URL (waar lander CTA-buttons naartoe wijzen)
# Wordt gebruikt als default voor offer_url in Module 4b
CLICKHUB_CTA_URL=https://petalvane.com/click

# OpenAI API key voor DALL-E 3 image generation (Module 3 auto-images)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Public URL van je presell-site (Vercel). Wordt gebruikt om image-URLs in
# MGID/Taboola CSV's te bouwen. Voorbeeld: https://presell-site-xyz.vercel.app
PRESELL_SITE_URL=https://your-presell-site.vercel.app

# Optioneel: Discord-webhook voor daily-report notificaties
# Aanmaken: Discord server -> Settings -> Integrations -> Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# MGID REST API — voor sub-ID drill-down + auto-blacklist (Stap 1+)
# Docs: https://help.mgid.com/api-advertisers
# Token via MGID dashboard. Client-ID staat in dashboard-URL (/clients/12345)
MGID_API_KEY=
MGID_CLIENT_ID=
